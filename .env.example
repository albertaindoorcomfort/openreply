# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Lead inbox (docs/lead-model.md)
# Shared with Apollo: signs the grant that releases an approved draft. 32+ characters.
# RELAY_GRANT_SECRET=
# Signs flow grants from Apollo for POST /api/flows/v1 (docs/relay-flows-api.md). Its own value, 32+ characters.
# RELAY_FLOW_GRANT_SECRET=
# Apollo's service URL and Relay's token there, so a takeover stops agents in Apollo too.
# APOLLO_URL=http://127.0.0.1:8787
# APOLLO_SERVICE_TOKEN=
# Outbound email for replies to web forms and email leads. A connected Outlook mailbox
# (Microsoft connection with Mail.Send) is used first: the conversation's own address,
# else LEADS_OUTLOOK_MAILBOX. SMTP is the fallback when no mailbox is connected.
# LEADS_OUTLOOK_MAILBOX=service@example.com
# When that mailbox is connected, its new Inbox mail also flows into the lead
# inbox. Mail received up to this many hours before connecting is picked up.
# MAIL_INGEST_LOOKBACK_HOURS=72
# LEADS_EMAIL_SERVER=smtps://user:pass@smtp.example.com:465
# LEADS_EMAIL_FROM=Alberta Indoor Comfort <service@example.com>
# SMS through the voice service (RingCentral).
# VOICE_SERVICE_URL=
# RELAY_DELIVERY_SECRET=
# AIC OS uses Claude when a key is set, otherwise deterministic rules.
# ANTHROPIC_API_KEY=
# CARLA_MODEL=claude-sonnet-5-5
# Thank-you page hosts a website form may redirect to, comma separated.
# LEADS_FORM_REDIRECT_HOSTS=www.example.com
# Set to "off" to stop copying Instagram DMs into the lead inbox.
# LEADS_INSTAGRAM_BRIDGE=on
# Meetings: Microsoft 365 (Outlook calendar, mail drafts, Teams metadata).
# See docs/meetings.md for the Entra app registration.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=your-directory-tenant-id
# Public HTTPS base Graph can reach, if different from NEXTAUTH_URL.
# MICROSOFT_WEBHOOK_BASE_URL=https://aic.example.com
# Email domains that count as internal (no approval needed to invite them).
# AIC_INTERNAL_DOMAINS=albertaindoorcomfort.com
# Lead model API (Relay) the meetings link to.
# RELAY_API_URL=http://localhost:3000
# Scopes: inbox:read timeline:write tasks:write assist:write feedback:write events:ingest
# RELAY_SERVICE_KEY=orly_...
# AIC OS's model access through Apollo's gateway. Without it, briefs are
# facts only and summaries use explicitly marked lines.
# APOLLO_GATEWAY_URL=
# APOLLO_RUNTIME_TOKEN=
# Apollo remote tools (contracts.md section 3).
# AIC_MODULE_SECRET_MEETINGS=
# AIC_TENANT_WORKSPACES=ten_xxx=workspaceId
# Voice provider key, used only to fetch call recordings for playback in the inbox.
# VAPI_API_KEY=
